# Sentinel AI Environment Configuration

# Server Settings
PORT=8000
API_PORT=8000
WEB_PORT=3000
HOST=0.0.0.0
ENV=development

# DataHub Integration
# GMS API endpoint (standard default: http://localhost:8080)
DATAHUB_GMS_URL=http://localhost:8080
# Official DataHub MCP server Streamable HTTP endpoint. Leave blank only if it is hosted at GMS_URL/mcp.
DATAHUB_MCP_ENDPOINT=
# For self-hosted DataHub Core, configure the pinned official local stdio server instead.
# Example command: C:/Users/<you>/.local/bin/uvx.exe
DATAHUB_MCP_COMMAND=
DATAHUB_MCP_ARGS=[]
DATAHUB_GMS_TOKEN=
# Optional one-time ingestion/admin token used only by scripts/seed_demo.py.
DATAHUB_SEED_TOKEN=
# Sentinel-side permission to request mutations; the MCP server must separately set TOOLS_IS_MUTATION_ENABLED=true.
DATAHUB_MUTATION_ENABLED=false
TOOLS_IS_MUTATION_ENABLED=false
SAVE_DOCUMENT_TOOL_ENABLED=true
DATAHUB_MCP_DOCUMENT_TOOLS_DISABLED=false
SENTINEL_DATA_MODE=live

# AI / LLM Configuration
# Supports OpenAI, Anthropic, or OpenAI-compatible endpoints
OPENAI_API_KEY=
AGENT_MODEL=gpt-4o

# GitHub Integration
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_PR_URL=

# Required for approval and mutation endpoints when external actions are enabled.
AUTH_MODE=static
SENTINEL_AUTH_TOKEN=
# Production alternative: validate an OIDC access token instead of a shared token.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHM=RS256
OIDC_REQUIRED_SCOPES=sentinel:mutate
OIDC_CLOCK_SKEW_SECONDS=30

# Comma-separated browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend API endpoint. NEXT_PUBLIC_* values are embedded during the frontend build.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Sentinel Local Storage
DATABASE_URL=sqlite:///./sentinel.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800

# Docker Compose production database defaults. Change the password outside local development.
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel-local-only
COMPOSE_DATABASE_URL=
DATAHUB_DOCKER_GMS_URL=http://host.docker.internal:8080
