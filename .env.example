# Sentinel AI Environment Configuration

# Server Settings
PORT=8000
HOST=0.0.0.0
ENV=development

# DataHub Integration
# GMS API endpoint (standard default: http://localhost:8080)
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=
DATAHUB_MUTATION_ENABLED=true

# AI / LLM Configuration
# Supports OpenAI, Anthropic, or OpenAI-compatible endpoints
OPENAI_API_KEY=
AGENT_MODEL=gpt-4o

# GitHub Integration
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo

# Sentinel Local Storage
DATABASE_URL=sqlite:///./sentinel.db
